    {
        "id": "a268ea1017fc75b4",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "RAZ compteurs",
        "func": "flow.set(\"nb_pieces\", 0);\nflow.set(\"temps_production\", 0);\nflow.set(\"debut_poste\", Date.now());   // ← nouvelle ligne\n\nnode.warn(\"Compteurs remis a zero - nouveau poste demarre\");\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1340,
        "y": 940,
        "wires": [
            []
        ]
    },
    {
        "id": "f0749c32ea6a918f",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "Calcul TRS",
        "func": "const TEMPS_CYCLE_THEORIQUE = 5200;  // ms, mesuré sur le terrain\n\nconst nbPieces = flow.get(\"nb_pieces\") || 0;\nconst tempsProd = flow.get(\"temps_production\") || 0;\nlet debutPoste = flow.get(\"debut_poste\");\n\n// Si le poste n'a jamais été initialisé, on le démarre maintenant\nif (!debutPoste) {\n    debutPoste = Date.now();\n    flow.set(\"debut_poste\", debutPoste);\n}\n\nconst tempsRequis = Date.now() - debutPoste;\n\n// Disponibilité : temps de production / temps écoulé depuis le début du poste\nconst dispo = tempsRequis > 0 ? (tempsProd / tempsRequis) : 0;\n\n// Performance : production idéale / production réelle\nconst perf = tempsProd > 0 ? ((nbPieces * TEMPS_CYCLE_THEORIQUE) / tempsProd) : 0;\n\n// Qualité : hypothèse, pas de capteur de rebut\nconst qualite = 1;\n\nconst trs = dispo * perf * qualite;\n\nmsg.payload = {\n    nb_pieces: nbPieces,\n    disponibilite: Math.round(dispo * 1000) / 10,   // en %\n    performance: Math.round(perf * 1000) / 10,\n    qualite: qualite * 100,\n    trs: Math.round(trs * 1000) / 10,\n    temps_poste_min: Math.round(tempsRequis / 60000)\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
