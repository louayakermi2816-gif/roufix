    {
        "id": "5b7c3af83c67bcca",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "Construire payload IHM",
        "func": "// Nœud function à placer juste avant le ui_template.\n// Il fusionne l'état automate et la sortie du diagnostic IA en un seul objet,\n// pour que le template n'ait qu'une seule source de vérité à afficher.\n\nconst etat = flow.get(\"etat_machine\") || {};\nconst diag = flow.get(\"diagnostic_ia\") || {};\n\nconst now = new Date();\nconst hh = String(now.getHours()).padStart(2, \"0\");\nconst mm = String(now.getMinutes()).padStart(2, \"0\");\nconst ss = String(now.getSeconds()).padStart(2, \"0\");\n\nmsg.payload = {\n    machine: \"ROUFIX 01\",\n\n    // MARCHE | ATTENTE | DEFAUT | ARRET  → pilote la couleur du rail et du pill\n    etat: etat.etat || \"ATTENTE\",\n    communication: etat.communication !== false,\n    cycle: etat.cycle || \"M1\",\n    cadence: etat.cadence || null,        // null → la tuile disparaît\n    horodatage: `${hh}:${mm}:${ss}`,\n\n    // Bloc diagnostic. Si anomalie est vide ou absent,\n    // le template bascule tout seul sur l'état \"aucune anomalie\".\n    anomalie: diag.anomalie || \"\",\n    causes_probables: diag.causes_probables || [],\n    action_immediate: diag.action_immediate || \"\",\n    criticite: diag.criticite || \"haute\"  // haute | moyenne | basse\n};\n\nreturn msg;\n\n// Côté flux : stocke l'état automate avec un function node en amont\n//   flow.set(\"etat_machine\", { etat: \"ATTENTE\", communication: true, cycle: \"M1\" });\n// et la réponse de l'IA avec\n//   flow.set(\"diagnostic_ia\", JSON.parse(msg.payload));",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
