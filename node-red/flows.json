    {
        "id": "4e3cea908607512a",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "Preparer prompt IA",
        "func": "const PROMPT_SYSTEME = `Tu es un expert en maintenance industrielle, specialise sur la machine de rognage de cables ROUFIX.\nArchitecture ROUFIX : deux moteurs DC (M1 disque abrasif, M2 entrainement cable), un verin pneumatique de fixation, temporisation de rognage de 3 secondes.\nTu assistes un technicien de nuit face a une derive statistique (carte de controle SPC) sur les temps de cycle.\nCONTRAINTES ABSOLUES :\n1. Reponds EXCLUSIVEMENT en JSON valide.\n2. AUCUN texte avant ou apres, AUCUNE balise markdown.\n3. Chaque champ : 15 mots maximum.\n4. 2 a 3 causes maximum, par probabilite decroissante, basees uniquement sur les composants reels de ROUFIX.\nFormat exact :\n{\"anomalie\":\"...\",\"causes_probables\":[\"...\",\"...\"],\"action_immediate\":\"...\"}`;\n\nconst donnees = `\nDONNEES DE L'ALERTE :\n- Statut detecte : ${msg.payload.statut}\n- Temps de cycle actuel : ${msg.payload.cycle} ms\n- Moyenne de reference : ${msg.payload.moyenne} ms\n- Limite superieure (LSC) : ${msg.payload.LSC} ms\n- Limite inferieure (LIC) : ${msg.payload.LIC} ms\n- Ecart : ${msg.payload.cycle - msg.payload.moyenne} ms`;\n\nmsg.payload = {\n    model: \"llama3.2\",\n    prompt: PROMPT_SYSTEME + donnees,\n    stream: false,\n    keep_alive: -1\n};\nmsg.requestTimeout = 40000;\nreturn msg;",
