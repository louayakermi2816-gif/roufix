        "name": "Detection derive",
        "func": "// --- Paramètres ---\nconst N_BASELINE = 10;        // 30-50 en production\nconst K_SIGMA = 3;            // limites à ±3σ (règle classique SPC)\n\nconst cycle = msg.payload.dernier_cycle;\n\n// --- Phase 1 : apprentissage ---\nlet baseline = flow.get(\"baseline\") || [];\nlet limites = flow.get(\"limites_spc\");\n\nif (!limites) {\n    baseline.push(cycle);\n    flow.set(\"baseline\", baseline);\n\n    if (baseline.length < N_BASELINE) {\n        msg.payload = {\n            phase: \"APPRENTISSAGE\",\n            progression: baseline.length + \"/\" + N_BASELINE,\n            statut: \"OK\"\n        };\n        return msg;\n    }\n\n    // Calcul de la moyenne et de l'écart-type\n    const moyenne = baseline.reduce((a, b) => a + b, 0) / baseline.length;\n    const variance = baseline.reduce((a, b) => a + Math.pow(b - moyenne, 2), 0) / baseline.length;\n    const ecartType = Math.sqrt(variance);\n\n    limites = {\n        moyenne: Math.round(moyenne),\n        sigma: Math.round(ecartType),\n        LSC: Math.round(moyenne + K_SIGMA * ecartType),\n        LIC: Math.round(moyenne - K_SIGMA * ecartType)\n    };\n    flow.set(\"limites_spc\", limites);\n\n    node.warn(\"Baseline etablie : moyenne=\" + limites.moyenne + \"ms, sigma=\" + limites.sigma);\n}\n\n// --- Phase 2 : contrôle sur limites figées ---\nlet statut = \"OK\";\nlet alerte = false;\n\nif (cycle > limites.LSC) {\n    statut = \"DERIVE HAUTE - cycle trop long\";\n    alerte = true;\n} else if (cycle < limites.LIC) {\n    statut = \"DERIVE BASSE - cycle anormalement court\";\n    alerte = true;\n}\n\n// Détection de tendance : 7 points consécutifs du même côté\nlet tendance = flow.get(\"tendance\") || 0;\nif (cycle > limites.moyenne) {\n    tendance = tendance > 0 ? tendance + 1 : 1;\n} else {\n    tendance = tendance < 0 ? tendance - 1 : -1;\n}\nflow.set(\"tendance\", tendance);\n\nif (Math.abs(tendance) >= 7 && !alerte) {\n    statut = \"TENDANCE - \" + Math.abs(tendance) + \" cycles consecutifs \"\n        + (tendance > 0 ? \"au-dessus\" : \"en-dessous\") + \" de la moyenne\";\n    alerte = true;\n}\n\nmsg.payload = {\n    phase: \"CONTROLE\",\n    cycle: cycle,\n    moyenne: limites.moyenne,\n    LSC: limites.LSC,\n    LIC: limites.LIC,\n    statut: statut,\n    alerte: alerte\n};\n\nreturn msg;",
