    {
        "id": "50f2d7bb356d5734",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "Compteur pieces",
        "func": "// Récupère le compteur, ou 0 s'il n'existe pas encore\nlet compteur = flow.get(\"nb_pieces\") || 0;\ncompteur++;\nflow.set(\"nb_pieces\", compteur);\n\n// Cumule le temps de production\nlet tempsProd = flow.get(\"temps_production\") || 0;\ntempsProd += msg.payload.duree_cycle;\nflow.set(\"temps_production\", tempsProd);\n\n// Prépare le message de sortie\nmsg.payload = {\n    nb_pieces: compteur,\n    dernier_cycle: msg.payload.duree_cycle,\n    temps_production_total: tempsProd\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1070,
        "y": 460,
