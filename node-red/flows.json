    {
        "id": "e8671ad50e8bf5bd",
        "type": "function",
        "z": "4b8bea3d1e25ea78",
        "name": "Preparer archive",
        "func": "const nbPieces = flow.get(\"nb_pieces\") || 0;\nconst tempsProd = flow.get(\"temps_production\") || 0;\nconst maintenant = new Date();\n\n// Temps de cycle moyen (protection contre division par zéro)\nconst cycleMoyen = nbPieces > 0 ? Math.round(tempsProd / nbPieces) : 0;\n\nmsg.payload = maintenant.toISOString() + \";\"\n            + nbPieces + \";\"\n            + tempsProd + \";\"\n            + cycleMoyen + \"\\n\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 820,
