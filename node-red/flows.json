        "name": "Extraire diagnostic",
        "func": "// Cas 1 : reponse valide de l'IA\nif (msg.payload && msg.payload.response && msg.payload.response.anomalie) {\n    msg.payload = msg.payload.response;\n    return msg;\n}\n\n// Cas 2 : erreur ou reponse malformee -> fallback\nmsg.payload = {\n    anomalie: \"Diagnostic IA local injoignable.\",\n    causes_probables: [\n        \"Service Ollama arrete\",\n        \"Surcharge processeur\"\n    ],\n    action_immediate: \"IA INDISPONIBLE - APPLIQUER LA GAMME DE MAINTENANCE STANDARD (Niv. 1)\"\n};\nreturn msg;",
