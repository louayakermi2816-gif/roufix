    {
        "id": "444928644cfb19c6",
        "type": "ui_template",
        "z": "4b8bea3d1e25ea78",
        "group": "1bf2602bd67f085b",
        "name": "Fiche diagnostic IA",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "<!--\n  ROUFIX — panneau de supervision\n  Node-RED dashboard 1.x — nœud ui_template (scope: Widget)\n\n  CONFIG DU NŒUD (obligatoire, sinon la scrollbar revient) :\n    Size  →  largeur : auto ou 12   |   hauteur : 0  (= auto)\n    Group →  décocher \"Display group name\" si tu veux le rendu plein cadre\n    Cocher \"Add output messages to...\" si tu utilises le bouton d'acquittement\n\n  PAYLOAD ATTENDU (voir roufix-payload-exemple.js) :\n    msg.payload.machine            \"ROUFIX 01\"\n    msg.payload.etat               \"MARCHE\" | \"ATTENTE\" | \"DEFAUT\" | \"ARRET\"\n    msg.payload.communication      true / false\n    msg.payload.cycle              \"M1\"\n    msg.payload.cadence            \"42 pcs/h\"\n    msg.payload.horodatage         \"14:32:07\"\n    msg.payload.anomalie           texte, ou vide/absent si tout va bien\n    msg.payload.causes_probables   tableau de chaînes\n    msg.payload.action_immediate   texte\n    msg.payload.criticite          \"haute\" | \"moyenne\" | \"basse\"\n-->\n\n<div class=\"rfx\" ng-class=\"'rfx--' + (msg.payload.etat || 'INCONNU' | lowercase)\">\n\n    <style>\n        .rfx {\n            --rfx-ink: #12161c;\n            --rfx-panel: #1a1f27;\n            --rfx-panel-2: #212831;\n            --rfx-line: rgba(255, 255, 255, .08);\n            --rfx-line-2: rgba(255, 255, 255, .14);\n            --rfx-text: #e6eaf0;\n            --rfx-muted: #8b94a3;\n            --rfx-faint: #626b79;\n\n            --rfx-green: #3fbf7f;\n            --rfx-amber: #f0a93b;\n            --rfx-red: #f2555a;\n            --rfx-blue: #6ea8ff;\n\n            --rfx-state: var(--rfx-faint);\n\n            font-family: \"Inter\", \"Roboto\", -apple-system, \"Segoe UI\", sans-serif;\n            color: var(--rfx-text);\n            background: var(--rfx-ink);\n            border-radius: 10px;\n            overflow: hidden;\n            display: block;\n        }\n\n        .rfx--marche {\n            --rfx-state: var(--rfx-green);\n        }\n\n        .rfx--attente {\n            --rfx-state: var(--rfx-amber);\n        }\n\n        .rfx--defaut {\n            --rfx-state: var(--rfx-red);\n        }\n\n        .rfx--arret {\n            --rfx-state: var(--rfx-faint);\n        }\n\n        /* ---- bandeau d'en-tête : le rail de statut est la signature du panneau ---- */\n        .rfx-head {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            padding: 14px 16px;\n            background: var(--rfx-panel);\n            border-bottom: 1px solid var(--rfx-line);\n            border-left: 3px solid var(--rfx-state);\n        }\n\n        .rfx-head__name {\n            font-size: 15px;\n            font-weight: 500;\n            letter-spacing: .01em;\n            margin: 0;\n            flex: 1;\n        }\n\n        .rfx-head__time {\n            font-family: ui-monospace, \"Roboto Mono\", \"Consolas\", monospace;\n            font-size: 12px;\n            color: var(--rfx-faint);\n            font-variant-numeric: tabular-nums;\n        }\n\n        .rfx-pill {\n            display: inline-flex;\n            align-items: center;\n            gap: 7px;\n            padding: 4px 11px 4px 9px;\n            border: 1px solid var(--rfx-state);\n            border-radius: 999px;\n            font-family: ui-monospace, \"Roboto Mono\", \"Consolas\", monospace;\n            font-size: 11px;\n            letter-spacing: .09em;\n            color: var(--rfx-state);\n            white-space: nowrap;\n        }\n\n        .rfx-dot {\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            background: var(--rfx-state);\n            flex: none;\n        }\n\n        .rfx--marche .rfx-dot {\n            animation: rfx-pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes rfx-pulse {\n            50% {\n                opacity: .25;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            .rfx--marche .rfx-dot {\n                animation: none;\n            }\n        }\n\n        /* ---- tuiles de mesure ---- */\n        .rfx-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n            gap: 1px;\n            background: var(--rfx-line);\n            border-bottom: 1px solid var(--rfx-line);\n        }\n\n        .rfx-tile {\n            background: var(--rfx-panel);\n            padding: 13px 16px;\n        }\n\n        .rfx-tile__label {\n            margin: 0 0 6px;\n            font-size: 10px;\n            letter-spacing: .13em;\n            text-transform: uppercase;\n            color: var(--rfx-faint);\n        }\n\n        .rfx-tile__value {\n            margin: 0;\n            font-family: ui-monospace, \"Roboto Mono\", \"Consolas\", monospace;\n            font-size: 17px;\n            font-weight: 500;\n            letter-spacing: .02em;\n            font-variant-numeric: tabular-nums;\n        }\n\n        .rfx-tile__value--state {\n            color: var(--rfx-state);\n        }\n\n        .rfx-tile__value--ok {\n            color: var(--rfx-green);\n        }\n\n        .rfx-tile__value--ko {\n            color: var(--rfx-red);\n        }\n\n        /* ---- bloc diagnostic ---- */\n        .rfx-diag {\n            padding: 16px;\n        }\n\n        .rfx-diag__head {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-bottom: 14px;\n        }\n\n        .rfx-diag__title {\n            margin: 0;\n            flex: 1;\n            font-size: 10px;\n            letter-spacing: .13em;\n            text-transform: uppercase;\n            color: var(--rfx-muted);\n        }\n\n        .rfx-badge {\n            font-size: 10px;\n            letter-spacing: .08em;\n            text-transform: uppercase;\n            padding: 3px 9px;\n            border-radius: 4px;\n            background: rgba(242, 85, 90, .13);\n            color: var(--rfx-red);\n        }\n\n        .rfx-badge--moyenne {\n            background: rgba(240, 169, 59, .13);\n            color: var(--rfx-amber);\n        }\n\n        .rfx-badge--basse {\n            background: rgba(110, 168, 255, .13);\n            color: var(--rfx-blue);\n        }\n\n        .rfx-anomalie {\n            margin: 0 0 16px;\n            font-size: 15px;\n            line-height: 1.45;\n        }\n\n        .rfx-causes {\n            list-style: none;\n            margin: 0 0 16px;\n            padding: 0;\n        }\n\n        .rfx-causes li {\n            display: flex;\n            gap: 11px;\n            align-items: baseline;\n            padding: 10px 0;\n            border-top: 1px solid var(--rfx-line);\n            font-size: 13.5px;\n            line-height: 1.45;\n            color: #c9d0da;\n        }\n\n        .rfx-causes li:last-child {\n            border-bottom: 1px solid var(--rfx-line);\n        }\n\n        .rfx-causes__idx {\n            font-family: ui-monospace, \"Roboto Mono\", \"Consolas\", monospace;\n            font-size: 11px;\n            color: var(--rfx-faint);\n            flex: none;\n        }\n\n        .rfx-action {\n            background: var(--rfx-panel-2);\n            border-left: 3px solid var(--rfx-red);\n            padding: 12px 14px;\n        }\n\n        .rfx-action__label {\n            margin: 0 0 5px;\n            font-size: 10px;\n            letter-spacing: .13em;\n            text-transform: uppercase;\n            color: var(--rfx-red);\n        }\n\n        .rfx-action__text {\n            margin: 0;\n            font-size: 14px;\n            line-height: 1.45;\n        }\n\n        .rfx-ack {\n            margin-top: 14px;\n            width: 100%;\n            background: transparent;\n            border: 1px solid var(--rfx-line-2);\n            border-radius: 6px;\n            color: var(--rfx-text);\n            padding: 9px 14px;\n            font-family: inherit;\n            font-size: 13px;\n            cursor: pointer;\n            transition: background .15s ease, border-color .15s ease;\n        }\n\n        .rfx-ack:hover {\n            background: var(--rfx-panel-2);\n            border-color: var(--rfx-muted);\n        }\n\n        .rfx-ack:active {\n            transform: scale(.99);\n        }\n\n        .rfx-ack:focus-visible {\n            outline: 2px solid var(--rfx-blue);\n            outline-offset: 2px;\n        }\n\n        /* ---- état sain ---- */\n        .rfx-clear {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            padding: 18px 16px;\n            font-size: 14px;\n            color: var(--rfx-muted);\n        }\n\n        .rfx-clear__dot {\n            width: 7px;\n            height: 7px;\n            border-radius: 50%;\n            background: var(--rfx-green);\n            flex: none;\n        }\n\n        /* neutralise le cadre du widget Node-RED */\n        .nr-dashboard-template {\n            overflow: visible !important;\n            padding: 0 !important;\n        }\n    </style>\n\n    <div class=\"rfx-head\">\n        <span class=\"rfx-dot\"></span>\n        <h3 class=\"rfx-head__name\">{{msg.payload.machine || 'ROUFIX'}}</h3>\n        <span class=\"rfx-head__time\">{{msg.payload.horodatage}}</span>\n    </div>\n\n    <div class=\"rfx-grid\">\n        <div class=\"rfx-tile\">\n            <p class=\"rfx-tile__label\">État actuel</p>\n            <p class=\"rfx-tile__value rfx-tile__value--state\">{{msg.payload.etat || '—'}}</p>\n        </div>\n        <div class=\"rfx-tile\">\n            <p class=\"rfx-tile__label\">Communication</p>\n            <p class=\"rfx-tile__value\"\n                ng-class=\"msg.payload.communication ? 'rfx-tile__value--ok' : 'rfx-tile__value--ko'\">\n                {{msg.payload.communication ? 'OK' : 'COUPÉE'}}\n            </p>\n        </div>\n        <div class=\"rfx-tile\">\n            <p class=\"rfx-tile__label\">Cycle</p>\n            <p class=\"rfx-tile__value\">{{msg.payload.cycle || '—'}}</p>\n        </div>\n        <div class=\"rfx-tile\" ng-if=\"msg.payload.cadence\">\n            <p class=\"rfx-tile__label\">Cadence</p>\n            <p class=\"rfx-tile__value\">{{msg.payload.cadence}}</p>\n        </div>\n    </div>\n\n    <div class=\"rfx-diag\" ng-if=\"msg.payload.anomalie\">\n        <div class=\"rfx-diag__head\">\n            <p class=\"rfx-diag__title\">Diagnostic IA</p>\n            <span class=\"rfx-badge\"\n            ng-class=\"'rfx-badge--' + (msg.payload.criticite || 'haute')\">\n        {{msg.payload.criticite || 'haute'}}\n      </span>\n        </div>\n\n        <p class=\"rfx-anomalie\">{{msg.payload.anomalie}}</p>\n\n        <ul class=\"rfx-causes\" ng-if=\"msg.payload.causes_probables.length\">\n            <li ng-repeat=\"cause in msg.payload.causes_probables track by $index\">\n                <span class=\"rfx-causes__idx\">{{$index + 1}}</span>\n                <span>{{cause}}</span>\n            </li>\n        </ul>\n\n        <div class=\"rfx-action\" ng-if=\"msg.payload.action_immediate\">\n            <p class=\"rfx-action__label\">Action immédiate</p>\n            <p class=\"rfx-action__text\">{{msg.payload.action_immediate}}</p>\n        </div>\n\n        <button class=\"rfx-ack\"\n            ng-click=\"send({topic: 'acquittement', payload: msg.payload.anomalie})\">\n      Marquer comme traité\n    </button>\n    </div>\n\n    <div class=\"rfx-clear\" ng-if=\"!msg.payload.anomalie\">\n        <span class=\"rfx-clear__dot\"></span>\n        <span>Aucune anomalie détectée sur ce cycle.</span>\n    </div>\n\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
